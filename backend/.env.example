# Electricity rate in pesos per kWh
ELECTRICITY_RATE=12.0
# Monthly bill before using AI (pesos)
BASELINE_BILL=1500
# Monthly budget the user wants to stay under (pesos)
MONTHLY_BUDGET=2000
# Day of the month the billing cycle starts
BILLING_CYCLE_START_DAY=1
# Bill received this month (pesos)
CURRENT_BILL=2500
# Rate per kWh in the baseline month (set different from ELECTRICITY_RATE if the rate changed)
BASELINE_RATE=12.0
# Grid emissions per kWh, for the CO2 comparison (default: Philippine DOE, Luzon-Visayas grid)
GRID_CO2_KG_PER_KWH=0.7122
# Grid emissions per kWh where cloud AI's data centers run (default: world average, IEA)
DATACENTER_CO2_KG_PER_KWH=0.45
# Monthly AI carbon budget in kg CO2, local + cloud (0 turns it off)
CARBON_BUDGET_KG=10
# Hourly grid carbon intensity for the cleanest-hours suggestion: a free personal token
# from https://app.electricitymaps.com, and your grid zone (PH-LU Luzon, PH-VI Visayas, PH-MI Mindanao)
ELECTRICITYMAPS_TOKEN=
ELECTRICITYMAPS_ZONE=PH-LU
# Power of the aircon used in "= X hours of aircon" (default: 1 HP non-inverter)
AIRCON_WATTS=750
# Where device readings are stored. Leave unset to use the SQLite file backend/data/wattage.db.
# For MySQL, run backend/db/setup_mysql.sql once, then:
# DATABASE_URL=mysql://wattage:change-me@localhost:3306/ai_wattage
